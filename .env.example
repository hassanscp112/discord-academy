# ---- Coach (cloud VM later, your PC during development) ----
COACH_TOKEN=               # Coach bot token from Discord Developer Portal
GUILD_ID=                  # your server's ID (enable Developer Mode in Discord, right-click server > Copy ID)

# ---- AI Admin (your PC only) ----
AI_TOKEN=                  # AI Admin bot token

# ---- Bosses: Discord user IDs allowed to command the AI Admin / see admin features (comma-separated) ----
BOSS_IDS=

# ---- General ----
TZ=                        # your timezone, e.g. Africa/Cairo — used for schedule times
DB_PATH=./data/academy.db

# ---- Coach web dashboard + API ----
PORT=8420                  # container hosts set SERVER_PORT instead — it wins over PORT
DASH_PASSWORD=             # login for the web dashboard — use 12+ characters if the dashboard is public
# TRUST_PROXY=1            # behind an HTTPS proxy (bot-hosting.net subdomain): rate-limit by the real client IP

# ---- Binaries (auto-detected; scripts/start.js fetches Linux builds into tools/ when missing) ----
# YTDLP_PATH=              # default: tools/yt-dlp.exe on Windows, else tools/yt-dlp, else yt-dlp on PATH
# FFMPEG_PATH=             # default: ffmpeg on PATH (start.js sets tools/ffmpeg when it had to download it)
# YTDLP_COOKIES=           # default: data/cookies.txt — REQUIRED on datacenter hosts or YouTube bot-blocks
API_TOKEN=                 # long random string; used by the AI Admin studio to talk to the Coach

# ---- AI Admin studio ----
STUDIO_PORT=8421
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
COACH_API_URL=http://localhost:8420
AI_ADMIN_CHANNEL=         # optional: channel id where you chat with the AI Admin in Discord

# Set to 1 to run the Coach's web/API/session engine WITHOUT Discord (local dev/testing)
COACH_DISABLE_DISCORD=

# Rendered image cards (member dashboards). Auto-detects Edge/Chrome/Chromium;
# set explicitly if your browser lives elsewhere (e.g. on the Oracle VM: /usr/bin/chromium).
# BROWSER_PATH=

# Class audio backend: ffmpeg (default, built-in yt-dlp→ffmpeg player) or lavalink.
# lavalink needs a Lavalink v4 node (deploy/lavalink/application.yml); ffmpeg remains
# the automatic fallback. Not recommended yet — see docs/7 (Lavalink notes).
# AUDIO_BACKEND=ffmpeg
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_SECURE=
# LAVALINK_LOCAL_FILES=1     # node runs on this machine and may read data/cache/*.opus

# PDF drop auto-detect in the uploads channel: enable "Message Content Intent"
# for the Coach app in the Discord developer portal, then set this to 1.
# COACH_MSG_INTENT=1
