# ---- Coach (cloud VM later, your PC during development) ----
COACH_TOKEN=               # Coach bot token from Discord Developer Portal
GUILD_ID=                  # your server's ID (enable Developer Mode in Discord, right-click server > Copy ID)

# ---- AI Admin (your PC only) ----
AI_TOKEN=                  # AI Admin bot token

# ---- Bosses: Discord user IDs allowed to command the AI Admin / see admin features (comma-separated) ----
BOSS_IDS=

# ---- General ----
TZ=                        # your timezone, e.g. Africa/Cairo — used for schedule times
DB_PATH=./data/academy.db

# ---- Coach web dashboard + API ----
PORT=8420
DASH_PASSWORD=             # login for the web dashboard
API_TOKEN=                 # long random string; used by the AI Admin studio to talk to the Coach

# ---- AI Admin studio ----
STUDIO_PORT=8421
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
COACH_API_URL=http://localhost:8420
AI_ADMIN_CHANNEL=         # optional: channel id where you chat with the AI Admin in Discord

# Set to 1 to run the Coach's web/API/session engine WITHOUT Discord (local dev/testing)
COACH_DISABLE_DISCORD=
