# ---- Discord (required) ----
COACH_TOKEN=               # bot token from the Discord Developer Portal
GUILD_ID=                  # your server's ID (Developer Mode → right-click the server → Copy ID)
BOSS_IDS=                  # owner Discord user IDs, comma-separated: admin buttons, DMs (health, backups, audio alerts)

# ---- Time ----
TZ=                        # your timezone, e.g. Asia/Riyadh — used for schedule times
# ACADEMY_TZ=Asia/Riyadh   # wins over TZ — set it on container hosts, which force TZ to their own zone
DB_PATH=./data/academy.db

# ---- Web dashboard ----
PORT=8420                  # container hosts set SERVER_PORT instead — it wins over PORT
DASH_PASSWORD=             # dashboard login — use 12+ characters when the dashboard is public
# TRUST_PROXY=1            # behind an HTTPS proxy (bot-hosting.net subdomain): rate-limit by the real client IP

# ---- Binaries (auto-detected; scripts/start.js fetches Linux builds into tools/ when missing) ----
# YTDLP_PATH=              # default: tools/yt-dlp.exe on Windows, else tools/yt-dlp, else yt-dlp on PATH
# FFMPEG_PATH=             # default: ffmpeg on PATH (start.js sets tools/ffmpeg when it had to download it)
# YTDLP_COOKIES=           # default: data/cookies.txt — REQUIRED on datacenter hosts or YouTube bot-blocks
# BROWSER_PATH=            # Chromium for image cards; default: Edge/Chrome, else start.js's chrome-headless-shell
# CARD_TIMEOUT_MS=60000    # card render timeout — raise on very slow hosts

# Set to 1 to run the web dashboard + engines WITHOUT Discord (local dev/testing)
COACH_DISABLE_DISCORD=

# Class audio backend: ffmpeg (default, built-in yt-dlp→ffmpeg player) or lavalink.
# lavalink needs a Lavalink v4 node (deploy/lavalink/application.yml); ffmpeg remains
# the automatic fallback. Not recommended yet — see docs/7 (Lavalink notes).
# AUDIO_BACKEND=ffmpeg
# LAVALINK_HOST=127.0.0.1
# LAVALINK_PORT=2333
# LAVALINK_PASSWORD=youshallnotpass
# LAVALINK_SECURE=
# LAVALINK_LOCAL_FILES=1     # node runs on this machine and may read data/cache/*.opus

# PDF drop auto-detect in the uploads channel: enable "Message Content Intent"
# for the bot in the Discord developer portal, then set this to 1.
# COACH_MSG_INTENT=1
