[Unit]
Description=Discord Academy Coach
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=coach
Group=coach
WorkingDirectory=/opt/discord-academy
EnvironmentFile=/opt/discord-academy/.env
# Linux binary paths (tools/ holds the Windows build)
Environment=YTDLP_PATH=/usr/local/bin/yt-dlp
Environment=BROWSER_PATH=/usr/bin/chromium-browser
ExecStart=/usr/bin/node src/coach/index.js
Restart=always
RestartSec=5
# hardening lite
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
